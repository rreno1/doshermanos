rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn()
        && currentUserProfile().data.status == 'active';
    }

    function hasRole(role) {
      return isActiveUser()
        && currentUserProfile().data.role == role;
    }

    function isCustomer() {
      return hasRole('customer');
    }

    function isStaffOrAdmin() {
      return hasRole('staff') || hasRole('admin');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function validUserDocument() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.role in ['customer', 'staff', 'admin']
        && request.resource.data.status in ['active', 'inactive', 'suspended']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validPackageDocument() {
      return request.resource.data.keys().hasOnly([
          'name', 'description', 'priceInCentavos', 'menuHighlights',
          'isActive', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'description', 'priceInCentavos', 'menuHighlights',
          'isActive', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.priceInCentavos is int
        && request.resource.data.priceInCentavos >= 0
        && request.resource.data.priceInCentavos <= 100000000
        && request.resource.data.menuHighlights is list
        && request.resource.data.menuHighlights.size() <= 20
        && request.resource.data.isActive is bool
        && request.resource.data.sortOrder is int
        && request.resource.data.sortOrder >= 0
        && request.resource.data.sortOrder <= 10000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validReservationEvent() {
      return request.resource.data.event is map
        && request.resource.data.event.keys().hasOnly([
          'startDate', 'endDate', 'location', 'guestCount', 'serviceRequirements'
        ])
        && request.resource.data.event.keys().hasAll([
          'startDate', 'endDate', 'location', 'guestCount', 'serviceRequirements'
        ])
        && request.resource.data.event.startDate is timestamp
        && request.resource.data.event.endDate is timestamp
        && request.resource.data.event.endDate >= request.resource.data.event.startDate
        && request.resource.data.event.location is string
        && request.resource.data.event.location.size() > 0
        && request.resource.data.event.location.size() <= 300
        && request.resource.data.event.guestCount is int
        && request.resource.data.event.guestCount > 0
        && request.resource.data.event.guestCount <= 10000
        && request.resource.data.event.serviceRequirements is string
        && request.resource.data.event.serviceRequirements.size() <= 1000;
    }

    function validReservationPackage() {
      return request.resource.data.package is map
        && request.resource.data.package.keys().hasOnly([
          'packageId', 'packageName', 'priceInCentavos'
        ])
        && request.resource.data.package.keys().hasAll([
          'packageId', 'packageName', 'priceInCentavos'
        ])
        && request.resource.data.package.packageId is string
        && request.resource.data.package.packageId.size() > 0
        && request.resource.data.package.packageName is string
        && request.resource.data.package.packageName.size() > 0
        && request.resource.data.package.packageName.size() <= 120
        && request.resource.data.package.priceInCentavos is int
        && request.resource.data.package.priceInCentavos >= 0
        && request.resource.data.package.priceInCentavos <= 100000000;
    }

    function validReservationDocument() {
      return request.resource.data.keys().hasOnly([
          'customerId', 'status', 'event', 'package', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'customerId', 'status', 'event', 'package', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.status in [
          'pending_review', 'confirmed', 'rejected', 'cancelled', 'completed'
        ]
        && validReservationEvent()
        && validReservationPackage()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function reservationPackageMatchesActivePackage() {
      let packageDocument = get(
        /databases/$(database)/documents/packages/$(request.resource.data.package.packageId)
      );

      return packageDocument.data.isActive == true
        && packageDocument.data.name == request.resource.data.package.packageName
        && packageDocument.data.priceInCentavos == request.resource.data.package.priceInCentavos;
    }

    function validInventoryDocument() {
      return request.resource.data.keys().hasOnly([
          'name', 'unit', 'quantity', 'lowStockThreshold', 'isActive',
          'lastMovementId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'unit', 'quantity', 'lowStockThreshold', 'isActive',
          'lastMovementId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= 100000000
        && request.resource.data.lowStockThreshold is int
        && request.resource.data.lowStockThreshold >= 0
        && request.resource.data.lowStockThreshold <= 100000000
        && request.resource.data.isActive is bool
        && (
          request.resource.data.lastMovementId == null
          || (
            request.resource.data.lastMovementId is string
            && request.resource.data.lastMovementId.size() > 0
            && request.resource.data.lastMovementId.size() <= 120
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validInventoryMovementDocument() {
      return request.resource.data.keys().hasOnly([
          'inventoryItemId', 'itemName', 'unit', 'type', 'quantityChange',
          'previousQuantity', 'newQuantity', 'note', 'recordedBy',
          'recordedByName', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'inventoryItemId', 'itemName', 'unit', 'type', 'quantityChange',
          'previousQuantity', 'newQuantity', 'note', 'recordedBy',
          'recordedByName', 'createdAt'
        ])
        && request.resource.data.inventoryItemId is string
        && request.resource.data.inventoryItemId.size() > 0
        && request.resource.data.itemName is string
        && request.resource.data.itemName.size() > 0
        && request.resource.data.itemName.size() <= 120
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.type in ['stock_in', 'stock_out', 'correction']
        && request.resource.data.quantityChange is int
        && request.resource.data.quantityChange != 0
        && request.resource.data.quantityChange >= -100000000
        && request.resource.data.quantityChange <= 100000000
        && request.resource.data.previousQuantity is int
        && request.resource.data.previousQuantity >= 0
        && request.resource.data.previousQuantity <= 100000000
        && request.resource.data.newQuantity is int
        && request.resource.data.newQuantity >= 0
        && request.resource.data.newQuantity <= 100000000
        && request.resource.data.newQuantity
          == request.resource.data.previousQuantity + request.resource.data.quantityChange
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && (
          request.resource.data.type != 'correction'
          || request.resource.data.note.size() >= 3
        )
        && (
          (request.resource.data.type == 'stock_in'
            && request.resource.data.quantityChange > 0)
          || (request.resource.data.type == 'stock_out'
            && request.resource.data.quantityChange < 0)
          || request.resource.data.type == 'correction'
        )
        && request.resource.data.recordedBy is string
        && request.resource.data.recordedBy.size() > 0
        && request.resource.data.recordedByName is string
        && request.resource.data.recordedByName.size() > 0
        && request.resource.data.recordedByName.size() <= 100
        && request.resource.data.createdAt is timestamp;
    }

    function inventoryQuantityChangeHasMatchingMovement(inventoryItemId) {
      let movementId = request.resource.data.lastMovementId;
      let movementDocument = getAfter(
        /databases/$(database)/documents/inventoryMovements/$(movementId)
      );

      return resource.data.isActive == true
        && movementId is string
        && movementId != resource.data.lastMovementId
        && movementDocument.data.inventoryItemId == inventoryItemId
        && movementDocument.data.previousQuantity == resource.data.quantity
        && movementDocument.data.newQuantity == request.resource.data.quantity
        && movementDocument.data.quantityChange
          == request.resource.data.quantity - resource.data.quantity
        && movementDocument.data.recordedBy == request.auth.uid
        && movementDocument.data.createdAt == request.time;
    }

    function inventoryMovementMatchesItemChange(movementId) {
      let previousItem = get(
        /databases/$(database)/documents/inventory/$(request.resource.data.inventoryItemId)
      );
      let updatedItem = getAfter(
        /databases/$(database)/documents/inventory/$(request.resource.data.inventoryItemId)
      );

      return previousItem.data.quantity == request.resource.data.previousQuantity
        && updatedItem.data.quantity == request.resource.data.newQuantity
        && updatedItem.data.lastMovementId == movementId
        && updatedItem.data.name == request.resource.data.itemName
        && updatedItem.data.unit == request.resource.data.unit;
    }

    function validPaymentDocument() {
      return request.resource.data.keys().hasOnly([
          'reservationId', 'customerId', 'packageName', 'eventStartDate',
          'amountInCentavos', 'method', 'reference', 'note', 'recordedBy',
          'recordedByName', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'reservationId', 'customerId', 'packageName', 'eventStartDate',
          'amountInCentavos', 'method', 'reference', 'note', 'recordedBy',
          'recordedByName', 'createdAt'
        ])
        && request.resource.data.reservationId is string
        && request.resource.data.reservationId.size() > 0
        && request.resource.data.reservationId.size() <= 120
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.packageName is string
        && request.resource.data.packageName.size() > 0
        && request.resource.data.packageName.size() <= 120
        && request.resource.data.eventStartDate is timestamp
        && request.resource.data.amountInCentavos is int
        && request.resource.data.amountInCentavos > 0
        && request.resource.data.amountInCentavos <= 100000000
        && request.resource.data.method == 'cash'
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 120
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.recordedBy is string
        && request.resource.data.recordedBy.size() > 0
        && request.resource.data.recordedByName is string
        && request.resource.data.recordedByName.size() > 0
        && request.resource.data.recordedByName.size() <= 100
        && request.resource.data.createdAt is timestamp;
    }

    function validPaymentReceiptDocument() {
      return request.resource.data.keys().hasOnly([
          'reservationId', 'customerId', 'packageName', 'eventStartDate',
          'amountInCentavos', 'method', 'reference', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'reservationId', 'customerId', 'packageName', 'eventStartDate',
          'amountInCentavos', 'method', 'reference', 'createdAt'
        ])
        && request.resource.data.reservationId is string
        && request.resource.data.reservationId.size() > 0
        && request.resource.data.reservationId.size() <= 120
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.packageName is string
        && request.resource.data.packageName.size() > 0
        && request.resource.data.packageName.size() <= 120
        && request.resource.data.eventStartDate is timestamp
        && request.resource.data.amountInCentavos is int
        && request.resource.data.amountInCentavos > 0
        && request.resource.data.amountInCentavos <= 100000000
        && request.resource.data.method == 'cash'
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 120
        && request.resource.data.createdAt is timestamp;
    }

    function paymentMatchesReservation() {
      let reservationPath = /databases/$(database)/documents/reservations/$(request.resource.data.reservationId);
      let reservation = get(reservationPath);

      return exists(reservationPath)
        && reservation.data.status in ['pending_review', 'confirmed', 'completed']
        && reservation.data.customerId == request.resource.data.customerId
        && reservation.data.package.packageName == request.resource.data.packageName
        && reservation.data.event.startDate == request.resource.data.eventStartDate;
    }

    function paymentHasMatchingReceipt(paymentId) {
      let receiptPath = /databases/$(database)/documents/paymentReceipts/$(paymentId);
      let receipt = getAfter(receiptPath);

      return existsAfter(receiptPath)
        && receipt.data.reservationId == request.resource.data.reservationId
        && receipt.data.customerId == request.resource.data.customerId
        && receipt.data.packageName == request.resource.data.packageName
        && receipt.data.eventStartDate == request.resource.data.eventStartDate
        && receipt.data.amountInCentavos == request.resource.data.amountInCentavos
        && receipt.data.method == request.resource.data.method
        && receipt.data.reference == request.resource.data.reference
        && receipt.data.createdAt == request.time;
    }

    function paymentReceiptHasMatchingPayment(paymentId) {
      let paymentPath = /databases/$(database)/documents/payments/$(paymentId);
      let payment = getAfter(paymentPath);

      return existsAfter(paymentPath)
        && payment.data.reservationId == request.resource.data.reservationId
        && payment.data.customerId == request.resource.data.customerId
        && payment.data.packageName == request.resource.data.packageName
        && payment.data.eventStartDate == request.resource.data.eventStartDate
        && payment.data.amountInCentavos == request.resource.data.amountInCentavos
        && payment.data.method == request.resource.data.method
        && payment.data.reference == request.resource.data.reference
        && payment.data.createdAt == request.time;
    }

    function validEquipmentDocument() {
      return request.resource.data.keys().hasOnly([
          'name', 'unit', 'totalQuantity', 'availableQuantity', 'inUseQuantity',
          'damagedQuantity', 'missingQuantity', 'isActive', 'lastTransactionId',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'unit', 'totalQuantity', 'availableQuantity', 'inUseQuantity',
          'damagedQuantity', 'missingQuantity', 'isActive', 'lastTransactionId',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.totalQuantity is int
        && request.resource.data.totalQuantity > 0
        && request.resource.data.totalQuantity <= 1000000
        && request.resource.data.availableQuantity is int
        && request.resource.data.availableQuantity >= 0
        && request.resource.data.inUseQuantity is int
        && request.resource.data.inUseQuantity >= 0
        && request.resource.data.damagedQuantity is int
        && request.resource.data.damagedQuantity >= 0
        && request.resource.data.missingQuantity is int
        && request.resource.data.missingQuantity >= 0
        && request.resource.data.totalQuantity
          == request.resource.data.availableQuantity
            + request.resource.data.inUseQuantity
            + request.resource.data.damagedQuantity
            + request.resource.data.missingQuantity
        && request.resource.data.isActive is bool
        && (
          request.resource.data.lastTransactionId == null
          || (
            request.resource.data.lastTransactionId is string
            && request.resource.data.lastTransactionId.size() > 0
            && request.resource.data.lastTransactionId.size() <= 120
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validEquipmentAssignmentDocument() {
      return request.resource.data.keys().hasOnly([
          'reservationId', 'customerId', 'packageName', 'eventStartDate', 'eventEndDate',
          'equipmentId', 'equipmentName', 'unit', 'assignedQuantity', 'status',
          'releaseTransactionId', 'returnTransactionId', 'returnedGoodQuantity',
          'damagedQuantity', 'missingQuantity', 'note', 'returnNote', 'createdBy',
          'createdByName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'reservationId', 'customerId', 'packageName', 'eventStartDate', 'eventEndDate',
          'equipmentId', 'equipmentName', 'unit', 'assignedQuantity', 'status',
          'releaseTransactionId', 'returnTransactionId', 'returnedGoodQuantity',
          'damagedQuantity', 'missingQuantity', 'note', 'returnNote', 'createdBy',
          'createdByName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.reservationId is string
        && request.resource.data.reservationId.size() > 0
        && request.resource.data.reservationId.size() <= 120
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.packageName is string
        && request.resource.data.packageName.size() > 0
        && request.resource.data.packageName.size() <= 120
        && request.resource.data.eventStartDate is timestamp
        && request.resource.data.eventEndDate is timestamp
        && request.resource.data.eventEndDate >= request.resource.data.eventStartDate
        && request.resource.data.equipmentId is string
        && request.resource.data.equipmentId.size() > 0
        && request.resource.data.equipmentId.size() <= 120
        && request.resource.data.equipmentName is string
        && request.resource.data.equipmentName.size() > 0
        && request.resource.data.equipmentName.size() <= 120
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.assignedQuantity is int
        && request.resource.data.assignedQuantity > 0
        && request.resource.data.assignedQuantity <= 1000000
        && request.resource.data.status in ['assigned', 'released', 'closed', 'cancelled']
        && request.resource.data.returnedGoodQuantity is int
        && request.resource.data.returnedGoodQuantity >= 0
        && request.resource.data.damagedQuantity is int
        && request.resource.data.damagedQuantity >= 0
        && request.resource.data.missingQuantity is int
        && request.resource.data.missingQuantity >= 0
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.returnNote is string
        && request.resource.data.returnNote.size() <= 500
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() > 0
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 100
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.status in ['assigned', 'cancelled']
            && request.resource.data.releaseTransactionId == null
            && request.resource.data.returnTransactionId == null
            && request.resource.data.returnedGoodQuantity == 0
            && request.resource.data.damagedQuantity == 0
            && request.resource.data.missingQuantity == 0
            && request.resource.data.returnNote == ''
          )
          || (
            request.resource.data.status == 'released'
            && request.resource.data.releaseTransactionId is string
            && request.resource.data.releaseTransactionId.size() > 0
            && request.resource.data.returnTransactionId == null
            && request.resource.data.returnedGoodQuantity == 0
            && request.resource.data.damagedQuantity == 0
            && request.resource.data.missingQuantity == 0
            && request.resource.data.returnNote == ''
          )
          || (
            request.resource.data.status == 'closed'
            && request.resource.data.releaseTransactionId is string
            && request.resource.data.releaseTransactionId.size() > 0
            && request.resource.data.returnTransactionId is string
            && request.resource.data.returnTransactionId.size() > 0
            && request.resource.data.returnedGoodQuantity
              + request.resource.data.damagedQuantity
              + request.resource.data.missingQuantity
              == request.resource.data.assignedQuantity
            && (
              (request.resource.data.damagedQuantity == 0
                && request.resource.data.missingQuantity == 0)
              || request.resource.data.returnNote.size() >= 3
            )
          )
        );
    }

    function validEquipmentTransactionDocument() {
      return request.resource.data.keys().hasOnly([
          'equipmentId', 'equipmentName', 'unit', 'assignmentId', 'reservationId',
          'type', 'quantity', 'returnedGoodQuantity', 'damagedQuantity',
          'missingQuantity', 'note', 'recordedBy', 'recordedByName', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'equipmentId', 'equipmentName', 'unit', 'assignmentId', 'reservationId',
          'type', 'quantity', 'returnedGoodQuantity', 'damagedQuantity',
          'missingQuantity', 'note', 'recordedBy', 'recordedByName', 'createdAt'
        ])
        && request.resource.data.equipmentId is string
        && request.resource.data.equipmentId.size() > 0
        && request.resource.data.equipmentId.size() <= 120
        && request.resource.data.equipmentName is string
        && request.resource.data.equipmentName.size() > 0
        && request.resource.data.equipmentName.size() <= 120
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() > 0
        && request.resource.data.assignmentId.size() <= 120
        && request.resource.data.reservationId is string
        && request.resource.data.reservationId.size() > 0
        && request.resource.data.reservationId.size() <= 120
        && request.resource.data.type in ['release', 'return']
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 1000000
        && request.resource.data.returnedGoodQuantity is int
        && request.resource.data.returnedGoodQuantity >= 0
        && request.resource.data.damagedQuantity is int
        && request.resource.data.damagedQuantity >= 0
        && request.resource.data.missingQuantity is int
        && request.resource.data.missingQuantity >= 0
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.recordedBy is string
        && request.resource.data.recordedBy.size() > 0
        && request.resource.data.recordedByName is string
        && request.resource.data.recordedByName.size() > 0
        && request.resource.data.recordedByName.size() <= 100
        && request.resource.data.createdAt is timestamp
        && (
          (
            request.resource.data.type == 'release'
            && request.resource.data.returnedGoodQuantity == 0
            && request.resource.data.damagedQuantity == 0
            && request.resource.data.missingQuantity == 0
            && request.resource.data.note == ''
          )
          || (
            request.resource.data.type == 'return'
            && request.resource.data.returnedGoodQuantity
              + request.resource.data.damagedQuantity
              + request.resource.data.missingQuantity
              == request.resource.data.quantity
            && (
              (request.resource.data.damagedQuantity == 0
                && request.resource.data.missingQuantity == 0)
              || request.resource.data.note.size() >= 3
            )
          )
        );
    }

    function equipmentAssignmentMatchesReferences() {
      let reservationPath = /databases/$(database)/documents/reservations/$(request.resource.data.reservationId);
      let equipmentPath = /databases/$(database)/documents/equipment/$(request.resource.data.equipmentId);
      let reservation = get(reservationPath);
      let equipment = get(equipmentPath);

      return exists(reservationPath)
        && exists(equipmentPath)
        && reservation.data.status in ['pending_review', 'confirmed']
        && reservation.data.customerId == request.resource.data.customerId
        && reservation.data.package.packageName == request.resource.data.packageName
        && reservation.data.event.startDate == request.resource.data.eventStartDate
        && reservation.data.event.endDate == request.resource.data.eventEndDate
        && equipment.data.isActive == true
        && equipment.data.name == request.resource.data.equipmentName
        && equipment.data.unit == request.resource.data.unit
        && request.resource.data.assignedQuantity <= equipment.data.totalQuantity
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName == currentUserProfile().data.displayName;
    }

    function equipmentUpdateHasMatchingTransaction(equipmentId) {
      let transactionId = request.resource.data.lastTransactionId;
      let transactionPath = /databases/$(database)/documents/equipmentTransactions/$(transactionId);
      let equipmentTransaction = getAfter(transactionPath);

      return transactionId is string
        && transactionId != resource.data.lastTransactionId
        && existsAfter(transactionPath)
        && equipmentTransaction.data.equipmentId == equipmentId
        && equipmentTransaction.data.recordedBy == request.auth.uid
        && equipmentTransaction.data.createdAt == request.time
        && (
          (
            equipmentTransaction.data.type == 'release'
            && resource.data.availableQuantity >= equipmentTransaction.data.quantity
            && request.resource.data.availableQuantity
              == resource.data.availableQuantity - equipmentTransaction.data.quantity
            && request.resource.data.inUseQuantity
              == resource.data.inUseQuantity + equipmentTransaction.data.quantity
            && request.resource.data.damagedQuantity == resource.data.damagedQuantity
            && request.resource.data.missingQuantity == resource.data.missingQuantity
          )
          || (
            equipmentTransaction.data.type == 'return'
            && resource.data.inUseQuantity >= equipmentTransaction.data.quantity
            && request.resource.data.availableQuantity
              == resource.data.availableQuantity
                + equipmentTransaction.data.returnedGoodQuantity
            && request.resource.data.inUseQuantity
              == resource.data.inUseQuantity - equipmentTransaction.data.quantity
            && request.resource.data.damagedQuantity
              == resource.data.damagedQuantity + equipmentTransaction.data.damagedQuantity
            && request.resource.data.missingQuantity
              == resource.data.missingQuantity + equipmentTransaction.data.missingQuantity
          )
        );
    }

    function assignmentReleaseHasMatchingTransaction(assignmentId) {
      let transactionId = request.resource.data.releaseTransactionId;
      let transactionPath = /databases/$(database)/documents/equipmentTransactions/$(transactionId);
      let equipmentPath = /databases/$(database)/documents/equipment/$(request.resource.data.equipmentId);
      let equipmentTransaction = getAfter(transactionPath);
      let previousEquipment = get(equipmentPath);
      let updatedEquipment = getAfter(equipmentPath);

      return existsAfter(transactionPath)
        && exists(equipmentPath)
        && existsAfter(equipmentPath)
        && equipmentTransaction.data.type == 'release'
        && equipmentTransaction.data.assignmentId == assignmentId
        && equipmentTransaction.data.reservationId == request.resource.data.reservationId
        && equipmentTransaction.data.equipmentId == request.resource.data.equipmentId
        && equipmentTransaction.data.equipmentName == request.resource.data.equipmentName
        && equipmentTransaction.data.unit == request.resource.data.unit
        && equipmentTransaction.data.quantity == request.resource.data.assignedQuantity
        && equipmentTransaction.data.recordedBy == request.auth.uid
        && equipmentTransaction.data.createdAt == request.time
        && previousEquipment.data.isActive == true
        && previousEquipment.data.availableQuantity >= request.resource.data.assignedQuantity
        && updatedEquipment.data.availableQuantity
          == previousEquipment.data.availableQuantity - request.resource.data.assignedQuantity
        && updatedEquipment.data.inUseQuantity
          == previousEquipment.data.inUseQuantity + request.resource.data.assignedQuantity
        && updatedEquipment.data.lastTransactionId == transactionId;
    }

    function assignmentReturnHasMatchingTransaction(assignmentId) {
      let transactionId = request.resource.data.returnTransactionId;
      let transactionPath = /databases/$(database)/documents/equipmentTransactions/$(transactionId);
      let equipmentPath = /databases/$(database)/documents/equipment/$(request.resource.data.equipmentId);
      let equipmentTransaction = getAfter(transactionPath);
      let previousEquipment = get(equipmentPath);
      let updatedEquipment = getAfter(equipmentPath);

      return existsAfter(transactionPath)
        && exists(equipmentPath)
        && existsAfter(equipmentPath)
        && equipmentTransaction.data.type == 'return'
        && equipmentTransaction.data.assignmentId == assignmentId
        && equipmentTransaction.data.reservationId == request.resource.data.reservationId
        && equipmentTransaction.data.equipmentId == request.resource.data.equipmentId
        && equipmentTransaction.data.equipmentName == request.resource.data.equipmentName
        && equipmentTransaction.data.unit == request.resource.data.unit
        && equipmentTransaction.data.quantity == request.resource.data.assignedQuantity
        && equipmentTransaction.data.returnedGoodQuantity == request.resource.data.returnedGoodQuantity
        && equipmentTransaction.data.damagedQuantity == request.resource.data.damagedQuantity
        && equipmentTransaction.data.missingQuantity == request.resource.data.missingQuantity
        && equipmentTransaction.data.note == request.resource.data.returnNote
        && equipmentTransaction.data.recordedBy == request.auth.uid
        && equipmentTransaction.data.createdAt == request.time
        && previousEquipment.data.inUseQuantity >= request.resource.data.assignedQuantity
        && updatedEquipment.data.availableQuantity
          == previousEquipment.data.availableQuantity + request.resource.data.returnedGoodQuantity
        && updatedEquipment.data.inUseQuantity
          == previousEquipment.data.inUseQuantity - request.resource.data.assignedQuantity
        && updatedEquipment.data.damagedQuantity
          == previousEquipment.data.damagedQuantity + request.resource.data.damagedQuantity
        && updatedEquipment.data.missingQuantity
          == previousEquipment.data.missingQuantity + request.resource.data.missingQuantity
        && updatedEquipment.data.lastTransactionId == transactionId;
    }

    function equipmentTransactionMatchesLinkedWrites(transactionId) {
      let equipmentPath = /databases/$(database)/documents/equipment/$(request.resource.data.equipmentId);
      let assignmentPath = /databases/$(database)/documents/equipmentAssignments/$(request.resource.data.assignmentId);
      let previousEquipment = get(equipmentPath);
      let updatedEquipment = getAfter(equipmentPath);
      let previousAssignment = get(assignmentPath);
      let updatedAssignment = getAfter(assignmentPath);

      return exists(equipmentPath)
        && existsAfter(equipmentPath)
        && exists(assignmentPath)
        && existsAfter(assignmentPath)
        && updatedEquipment.data.lastTransactionId == transactionId
        && previousAssignment.data.reservationId == request.resource.data.reservationId
        && previousAssignment.data.equipmentId == request.resource.data.equipmentId
        && previousAssignment.data.equipmentName == request.resource.data.equipmentName
        && previousAssignment.data.unit == request.resource.data.unit
        && previousAssignment.data.assignedQuantity == request.resource.data.quantity
        && (
          (
            request.resource.data.type == 'release'
            && previousAssignment.data.status == 'assigned'
            && updatedAssignment.data.status == 'released'
            && updatedAssignment.data.releaseTransactionId == transactionId
            && previousEquipment.data.isActive == true
            && previousEquipment.data.availableQuantity >= request.resource.data.quantity
            && updatedEquipment.data.availableQuantity
              == previousEquipment.data.availableQuantity - request.resource.data.quantity
            && updatedEquipment.data.inUseQuantity
              == previousEquipment.data.inUseQuantity + request.resource.data.quantity
          )
          || (
            request.resource.data.type == 'return'
            && previousAssignment.data.status == 'released'
            && updatedAssignment.data.status == 'closed'
            && updatedAssignment.data.returnTransactionId == transactionId
            && updatedAssignment.data.returnedGoodQuantity
              == request.resource.data.returnedGoodQuantity
            && updatedAssignment.data.damagedQuantity == request.resource.data.damagedQuantity
            && updatedAssignment.data.missingQuantity == request.resource.data.missingQuantity
            && updatedAssignment.data.returnNote == request.resource.data.note
            && previousEquipment.data.inUseQuantity >= request.resource.data.quantity
            && updatedEquipment.data.availableQuantity
              == previousEquipment.data.availableQuantity + request.resource.data.returnedGoodQuantity
            && updatedEquipment.data.inUseQuantity
              == previousEquipment.data.inUseQuantity - request.resource.data.quantity
            && updatedEquipment.data.damagedQuantity
              == previousEquipment.data.damagedQuantity + request.resource.data.damagedQuantity
            && updatedEquipment.data.missingQuantity
              == previousEquipment.data.missingQuantity + request.resource.data.missingQuantity
          )
        );
    }

    match /users/{userId} {
      allow get: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && validUserDocument()
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && validUserDocument()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && validUserDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /packages/{packageId} {
      allow get, list: if resource.data.isActive == true || isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validPackageDocument()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isStaffOrAdmin()
        && validPackageDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow get, list: if isStaffOrAdmin()
        || (isCustomer() && resource.data.customerId == request.auth.uid);

      allow create: if isCustomer()
        && validReservationDocument()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && reservationPackageMatchesActivePackage();

      allow update: if isStaffOrAdmin()
        && validReservationDocument()
        && resource.data.status == 'pending_review'
        && request.resource.data.status == 'rejected'
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.event == resource.data.event
        && request.resource.data.package == resource.data.package
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /inventory/{inventoryItemId} {
      allow get, list: if isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validInventoryDocument()
        && request.resource.data.quantity == 0
        && request.resource.data.lastMovementId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isStaffOrAdmin()
        && validInventoryDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.quantity == resource.data.quantity
            && request.resource.data.lastMovementId == resource.data.lastMovementId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'unit', 'lowStockThreshold', 'isActive', 'updatedAt'
            ])
          )
          || (
            request.resource.data.quantity != resource.data.quantity
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'quantity', 'lastMovementId', 'updatedAt'
            ])
            && inventoryQuantityChangeHasMatchingMovement(inventoryItemId)
          )
        );

      allow delete: if false;
    }

    match /inventoryMovements/{movementId} {
      allow get, list: if isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validInventoryMovementDocument()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.recordedByName == currentUserProfile().data.displayName
        && request.resource.data.createdAt == request.time
        && inventoryMovementMatchesItemChange(movementId);

      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow get, list: if isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validPaymentDocument()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.recordedByName == currentUserProfile().data.displayName
        && request.resource.data.createdAt == request.time
        && paymentMatchesReservation()
        && paymentHasMatchingReceipt(paymentId);

      allow update, delete: if false;
    }

    match /paymentReceipts/{paymentId} {
      allow get, list: if isStaffOrAdmin()
        || (isCustomer() && resource.data.customerId == request.auth.uid);

      allow create: if isStaffOrAdmin()
        && validPaymentReceiptDocument()
        && request.resource.data.createdAt == request.time
        && paymentReceiptHasMatchingPayment(paymentId);

      allow update, delete: if false;
    }

    match /equipment/{equipmentId} {
      allow get, list: if isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validEquipmentDocument()
        && request.resource.data.availableQuantity == request.resource.data.totalQuantity
        && request.resource.data.inUseQuantity == 0
        && request.resource.data.damagedQuantity == 0
        && request.resource.data.missingQuantity == 0
        && request.resource.data.lastTransactionId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isStaffOrAdmin()
        && validEquipmentDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.totalQuantity == resource.data.totalQuantity
        && request.resource.data.unit == resource.data.unit
        && (
          (
            request.resource.data.availableQuantity == resource.data.availableQuantity
            && request.resource.data.inUseQuantity == resource.data.inUseQuantity
            && request.resource.data.damagedQuantity == resource.data.damagedQuantity
            && request.resource.data.missingQuantity == resource.data.missingQuantity
            && request.resource.data.lastTransactionId == resource.data.lastTransactionId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'isActive', 'updatedAt'
            ])
            && (request.resource.data.isActive == true || resource.data.inUseQuantity == 0)
          )
          || (
            request.resource.data.name == resource.data.name
            && request.resource.data.isActive == resource.data.isActive
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'availableQuantity', 'inUseQuantity', 'damagedQuantity',
              'missingQuantity', 'lastTransactionId', 'updatedAt'
            ])
            && equipmentUpdateHasMatchingTransaction(equipmentId)
          )
        );

      allow delete: if false;
    }

    match /equipmentAssignments/{assignmentId} {
      allow get, list: if isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validEquipmentAssignmentDocument()
        && request.resource.data.status == 'assigned'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && equipmentAssignmentMatchesReferences();

      allow update: if isStaffOrAdmin()
        && validEquipmentAssignmentDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reservationId == resource.data.reservationId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.packageName == resource.data.packageName
        && request.resource.data.eventStartDate == resource.data.eventStartDate
        && request.resource.data.eventEndDate == resource.data.eventEndDate
        && request.resource.data.equipmentId == resource.data.equipmentId
        && request.resource.data.equipmentName == resource.data.equipmentName
        && request.resource.data.unit == resource.data.unit
        && request.resource.data.assignedQuantity == resource.data.assignedQuantity
        && request.resource.data.note == resource.data.note
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && (
          (
            resource.data.status == 'assigned'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt'
            ])
          )
          || (
            resource.data.status == 'assigned'
            && request.resource.data.status == 'released'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'releaseTransactionId', 'updatedAt'
            ])
            && assignmentReleaseHasMatchingTransaction(assignmentId)
          )
          || (
            resource.data.status == 'released'
            && request.resource.data.status == 'closed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'returnTransactionId', 'returnedGoodQuantity',
              'damagedQuantity', 'missingQuantity', 'returnNote', 'updatedAt'
            ])
            && assignmentReturnHasMatchingTransaction(assignmentId)
          )
        );

      allow delete: if false;
    }

    match /equipmentTransactions/{transactionId} {
      allow get, list: if isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validEquipmentTransactionDocument()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.recordedByName == currentUserProfile().data.displayName
        && request.resource.data.createdAt == request.time
        && equipmentTransactionMatchesLinkedWrites(transactionId);

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
