rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn()
        && currentUserProfile().data.status == 'active';
    }

    function hasRole(role) {
      return isActiveUser()
        && currentUserProfile().data.role == role;
    }

    function isCustomer() {
      return hasRole('customer');
    }

    function isStaffOrAdmin() {
      return hasRole('staff') || hasRole('admin');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function validUserDocument() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.role in ['customer', 'staff', 'admin']
        && request.resource.data.status in ['active', 'inactive', 'suspended']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validPackageDocument() {
      return request.resource.data.keys().hasOnly([
          'name', 'description', 'priceInCentavos', 'menuHighlights',
          'isActive', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'description', 'priceInCentavos', 'menuHighlights',
          'isActive', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.priceInCentavos is int
        && request.resource.data.priceInCentavos >= 0
        && request.resource.data.priceInCentavos <= 100000000
        && request.resource.data.menuHighlights is list
        && request.resource.data.menuHighlights.size() <= 20
        && request.resource.data.isActive is bool
        && request.resource.data.sortOrder is int
        && request.resource.data.sortOrder >= 0
        && request.resource.data.sortOrder <= 10000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validReservationEvent() {
      return request.resource.data.event is map
        && request.resource.data.event.keys().hasOnly([
          'startDate', 'endDate', 'location', 'guestCount', 'serviceRequirements'
        ])
        && request.resource.data.event.keys().hasAll([
          'startDate', 'endDate', 'location', 'guestCount', 'serviceRequirements'
        ])
        && request.resource.data.event.startDate is timestamp
        && request.resource.data.event.endDate is timestamp
        && request.resource.data.event.endDate >= request.resource.data.event.startDate
        && request.resource.data.event.location is string
        && request.resource.data.event.location.size() > 0
        && request.resource.data.event.location.size() <= 300
        && request.resource.data.event.guestCount is int
        && request.resource.data.event.guestCount > 0
        && request.resource.data.event.guestCount <= 10000
        && request.resource.data.event.serviceRequirements is string
        && request.resource.data.event.serviceRequirements.size() <= 1000;
    }

    function validReservationPackage() {
      return request.resource.data.package is map
        && request.resource.data.package.keys().hasOnly([
          'packageId', 'packageName', 'priceInCentavos'
        ])
        && request.resource.data.package.keys().hasAll([
          'packageId', 'packageName', 'priceInCentavos'
        ])
        && request.resource.data.package.packageId is string
        && request.resource.data.package.packageId.size() > 0
        && request.resource.data.package.packageName is string
        && request.resource.data.package.packageName.size() > 0
        && request.resource.data.package.packageName.size() <= 120
        && request.resource.data.package.priceInCentavos is int
        && request.resource.data.package.priceInCentavos >= 0
        && request.resource.data.package.priceInCentavos <= 100000000;
    }

    function validReservationDocument() {
      return request.resource.data.keys().hasOnly([
          'customerId', 'status', 'event', 'package', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'customerId', 'status', 'event', 'package', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.status in [
          'pending_review', 'confirmed', 'rejected', 'cancelled', 'completed'
        ]
        && validReservationEvent()
        && validReservationPackage()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function reservationPackageMatchesActivePackage() {
      let packageDocument = get(
        /databases/$(database)/documents/packages/$(request.resource.data.package.packageId)
      );

      return packageDocument.data.isActive == true
        && packageDocument.data.name == request.resource.data.package.packageName
        && packageDocument.data.priceInCentavos == request.resource.data.package.priceInCentavos;
    }

    function validInventoryDocument() {
      return request.resource.data.keys().hasOnly([
          'name', 'unit', 'quantity', 'lowStockThreshold', 'isActive',
          'lastMovementId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'unit', 'quantity', 'lowStockThreshold', 'isActive',
          'lastMovementId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= 100000000
        && request.resource.data.lowStockThreshold is int
        && request.resource.data.lowStockThreshold >= 0
        && request.resource.data.lowStockThreshold <= 100000000
        && request.resource.data.isActive is bool
        && (
          request.resource.data.lastMovementId == null
          || (
            request.resource.data.lastMovementId is string
            && request.resource.data.lastMovementId.size() > 0
            && request.resource.data.lastMovementId.size() <= 120
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validInventoryMovementDocument() {
      return request.resource.data.keys().hasOnly([
          'inventoryItemId', 'itemName', 'unit', 'type', 'quantityChange',
          'previousQuantity', 'newQuantity', 'note', 'recordedBy',
          'recordedByName', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'inventoryItemId', 'itemName', 'unit', 'type', 'quantityChange',
          'previousQuantity', 'newQuantity', 'note', 'recordedBy',
          'recordedByName', 'createdAt'
        ])
        && request.resource.data.inventoryItemId is string
        && request.resource.data.inventoryItemId.size() > 0
        && request.resource.data.itemName is string
        && request.resource.data.itemName.size() > 0
        && request.resource.data.itemName.size() <= 120
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && request.resource.data.type in ['stock_in', 'stock_out', 'correction']
        && request.resource.data.quantityChange is int
        && request.resource.data.quantityChange != 0
        && request.resource.data.quantityChange >= -100000000
        && request.resource.data.quantityChange <= 100000000
        && request.resource.data.previousQuantity is int
        && request.resource.data.previousQuantity >= 0
        && request.resource.data.previousQuantity <= 100000000
        && request.resource.data.newQuantity is int
        && request.resource.data.newQuantity >= 0
        && request.resource.data.newQuantity <= 100000000
        && request.resource.data.newQuantity
          == request.resource.data.previousQuantity + request.resource.data.quantityChange
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && (
          request.resource.data.type != 'correction'
          || request.resource.data.note.size() >= 3
        )
        && (
          (request.resource.data.type == 'stock_in'
            && request.resource.data.quantityChange > 0)
          || (request.resource.data.type == 'stock_out'
            && request.resource.data.quantityChange < 0)
          || request.resource.data.type == 'correction'
        )
        && request.resource.data.recordedBy is string
        && request.resource.data.recordedBy.size() > 0
        && request.resource.data.recordedByName is string
        && request.resource.data.recordedByName.size() > 0
        && request.resource.data.recordedByName.size() <= 100
        && request.resource.data.createdAt is timestamp;
    }

    function inventoryQuantityChangeHasMatchingMovement(inventoryItemId) {
      let movementId = request.resource.data.lastMovementId;
      let movementDocument = getAfter(
        /databases/$(database)/documents/inventoryMovements/$(movementId)
      );

      return resource.data.isActive == true
        && movementId is string
        && movementId != resource.data.lastMovementId
        && movementDocument.data.inventoryItemId == inventoryItemId
        && movementDocument.data.previousQuantity == resource.data.quantity
        && movementDocument.data.newQuantity == request.resource.data.quantity
        && movementDocument.data.quantityChange
          == request.resource.data.quantity - resource.data.quantity
        && movementDocument.data.recordedBy == request.auth.uid
        && movementDocument.data.createdAt == request.time;
    }

    function inventoryMovementMatchesItemChange(movementId) {
      let previousItem = get(
        /databases/$(database)/documents/inventory/$(request.resource.data.inventoryItemId)
      );
      let updatedItem = getAfter(
        /databases/$(database)/documents/inventory/$(request.resource.data.inventoryItemId)
      );

      return previousItem.data.quantity == request.resource.data.previousQuantity
        && updatedItem.data.quantity == request.resource.data.newQuantity
        && updatedItem.data.lastMovementId == movementId
        && updatedItem.data.name == request.resource.data.itemName
        && updatedItem.data.unit == request.resource.data.unit;
    }

    function validPaymentDocument() {
      return request.resource.data.keys().hasOnly([
          'reservationId', 'customerId', 'packageName', 'eventStartDate',
          'amountInCentavos', 'method', 'reference', 'note', 'recordedBy',
          'recordedByName', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'reservationId', 'customerId', 'packageName', 'eventStartDate',
          'amountInCentavos', 'method', 'reference', 'note', 'recordedBy',
          'recordedByName', 'createdAt'
        ])
        && request.resource.data.reservationId is string
        && request.resource.data.reservationId.size() > 0
        && request.resource.data.reservationId.size() <= 120
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.packageName is string
        && request.resource.data.packageName.size() > 0
        && request.resource.data.packageName.size() <= 120
        && request.resource.data.eventStartDate is timestamp
        && request.resource.data.amountInCentavos is int
        && request.resource.data.amountInCentavos > 0
        && request.resource.data.amountInCentavos <= 100000000
        && request.resource.data.method == 'cash'
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 120
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.recordedBy is string
        && request.resource.data.recordedBy.size() > 0
        && request.resource.data.recordedByName is string
        && request.resource.data.recordedByName.size() > 0
        && request.resource.data.recordedByName.size() <= 100
        && request.resource.data.createdAt is timestamp;
    }

    function validPaymentReceiptDocument() {
      return request.resource.data.keys().hasOnly([
          'reservationId', 'customerId', 'packageName', 'eventStartDate',
          'amountInCentavos', 'method', 'reference', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'reservationId', 'customerId', 'packageName', 'eventStartDate',
          'amountInCentavos', 'method', 'reference', 'createdAt'
        ])
        && request.resource.data.reservationId is string
        && request.resource.data.reservationId.size() > 0
        && request.resource.data.reservationId.size() <= 120
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.packageName is string
        && request.resource.data.packageName.size() > 0
        && request.resource.data.packageName.size() <= 120
        && request.resource.data.eventStartDate is timestamp
        && request.resource.data.amountInCentavos is int
        && request.resource.data.amountInCentavos > 0
        && request.resource.data.amountInCentavos <= 100000000
        && request.resource.data.method == 'cash'
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 120
        && request.resource.data.createdAt is timestamp;
    }

    function paymentMatchesReservation() {
      let reservationPath = /databases/$(database)/documents/reservations/$(request.resource.data.reservationId);
      let reservation = get(reservationPath);

      return exists(reservationPath)
        && reservation.data.status in ['pending_review', 'confirmed', 'completed']
        && reservation.data.customerId == request.resource.data.customerId
        && reservation.data.package.packageName == request.resource.data.packageName
        && reservation.data.event.startDate == request.resource.data.eventStartDate;
    }

    function paymentHasMatchingReceipt(paymentId) {
      let receiptPath = /databases/$(database)/documents/paymentReceipts/$(paymentId);
      let receipt = getAfter(receiptPath);

      return existsAfter(receiptPath)
        && receipt.data.reservationId == request.resource.data.reservationId
        && receipt.data.customerId == request.resource.data.customerId
        && receipt.data.packageName == request.resource.data.packageName
        && receipt.data.eventStartDate == request.resource.data.eventStartDate
        && receipt.data.amountInCentavos == request.resource.data.amountInCentavos
        && receipt.data.method == request.resource.data.method
        && receipt.data.reference == request.resource.data.reference
        && receipt.data.createdAt == request.time;
    }

    function paymentReceiptHasMatchingPayment(paymentId) {
      let paymentPath = /databases/$(database)/documents/payments/$(paymentId);
      let payment = getAfter(paymentPath);

      return existsAfter(paymentPath)
        && payment.data.reservationId == request.resource.data.reservationId
        && payment.data.customerId == request.resource.data.customerId
        && payment.data.packageName == request.resource.data.packageName
        && payment.data.eventStartDate == request.resource.data.eventStartDate
        && payment.data.amountInCentavos == request.resource.data.amountInCentavos
        && payment.data.method == request.resource.data.method
        && payment.data.reference == request.resource.data.reference
        && payment.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && validUserDocument()
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && validUserDocument()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && validUserDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /packages/{packageId} {
      allow get, list: if resource.data.isActive == true || isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validPackageDocument()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isStaffOrAdmin()
        && validPackageDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow get, list: if isStaffOrAdmin()
        || (isCustomer() && resource.data.customerId == request.auth.uid);

      allow create: if isCustomer()
        && validReservationDocument()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && reservationPackageMatchesActivePackage();

      allow update: if isStaffOrAdmin()
        && validReservationDocument()
        && resource.data.status == 'pending_review'
        && request.resource.data.status == 'rejected'
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.event == resource.data.event
        && request.resource.data.package == resource.data.package
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /inventory/{inventoryItemId} {
      allow get, list: if isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validInventoryDocument()
        && request.resource.data.quantity == 0
        && request.resource.data.lastMovementId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isStaffOrAdmin()
        && validInventoryDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.quantity == resource.data.quantity
            && request.resource.data.lastMovementId == resource.data.lastMovementId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'unit', 'lowStockThreshold', 'isActive', 'updatedAt'
            ])
          )
          || (
            request.resource.data.quantity != resource.data.quantity
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'quantity', 'lastMovementId', 'updatedAt'
            ])
            && inventoryQuantityChangeHasMatchingMovement(inventoryItemId)
          )
        );

      allow delete: if false;
    }

    match /inventoryMovements/{movementId} {
      allow get, list: if isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validInventoryMovementDocument()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.recordedByName == currentUserProfile().data.displayName
        && request.resource.data.createdAt == request.time
        && inventoryMovementMatchesItemChange(movementId);

      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow get, list: if isStaffOrAdmin();

      allow create: if isStaffOrAdmin()
        && validPaymentDocument()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.recordedByName == currentUserProfile().data.displayName
        && request.resource.data.createdAt == request.time
        && paymentMatchesReservation()
        && paymentHasMatchingReceipt(paymentId);

      allow update, delete: if false;
    }

    match /paymentReceipts/{paymentId} {
      allow get, list: if isStaffOrAdmin()
        || (isCustomer() && resource.data.customerId == request.auth.uid);

      allow create: if isStaffOrAdmin()
        && validPaymentReceiptDocument()
        && request.resource.data.createdAt == request.time
        && paymentReceiptHasMatchingPayment(paymentId);

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
