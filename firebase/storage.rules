rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
    }

    function isStaffOrAdmin() {
      return isSignedIn()
        && currentUserProfile().data.status == 'active'
        && currentUserProfile().data.role in ['staff', 'admin'];
    }

    function isAllowedImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /inventory/{allPaths=**} {
      allow list: if isStaffOrAdmin();
    }

    match /inventory/{inventoryItemId}/item-image {
      allow get: if isStaffOrAdmin();
      allow create, update: if isStaffOrAdmin() && isAllowedImage();
      allow delete: if isStaffOrAdmin();
    }

    match /equipment/{allPaths=**} {
      allow list: if isStaffOrAdmin();
    }

    match /equipment/{equipmentItemId}/item-image {
      allow get: if isStaffOrAdmin();
      allow create, update: if isStaffOrAdmin() && isAllowedImage();
      allow delete: if isStaffOrAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
