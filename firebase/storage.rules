rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
    }

    function isStaffOrAdmin() {
      return isSignedIn()
        && currentUserProfile().data.status == 'active'
        && currentUserProfile().data.role in ['staff', 'admin'];
    }

    function isAllowedImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function inventoryItemExists(inventoryItemId) {
      return firestore.exists(
        /databases/(default)/documents/inventory/$(inventoryItemId)
      );
    }

    function equipmentItemAcceptsImage(equipmentItemId) {
      let itemPath = /databases/(default)/documents/equipment/$(equipmentItemId);
      return firestore.exists(itemPath)
        && firestore.get(itemPath).data.get('isDeleted', false) != true;
    }

    match /inventory/{allPaths=**} {
      allow list: if isStaffOrAdmin();
    }

    match /inventory/{inventoryItemId}/item-image {
      allow get: if isStaffOrAdmin() && inventoryItemExists(inventoryItemId);
      allow create, update: if isStaffOrAdmin()
        && inventoryItemExists(inventoryItemId)
        && isAllowedImage();
      allow delete: if isStaffOrAdmin();
    }

    match /equipment/{allPaths=**} {
      allow list: if isStaffOrAdmin();
    }

    match /equipment/{equipmentItemId}/item-image {
      allow get: if isStaffOrAdmin() && equipmentItemAcceptsImage(equipmentItemId);
      allow create, update: if isStaffOrAdmin()
        && equipmentItemAcceptsImage(equipmentItemId)
        && isAllowedImage();
      allow delete: if isStaffOrAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
