# Development Firebase project only.
# Create a separate Firebase project for local/dev work and paste its public web app config here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check is intentionally optional in local development. Never place an
# App Check debug token in a committed environment file.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
