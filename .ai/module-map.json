{
  "title": "System Module Map",
  "file_id": "module-map.json",
  "dependency_flow": [
    "Module 01 — User Access & RBAC",
    "Module 02 — Catering Packages & Menu",
    "Module 03 — Online Reservation",
    "Module 05 — Package Customization",
    "Module 04 — Event Scheduling & Confirmation",
    "Module 07 — Catering Order Creation (Shared Milestone)",
    "Module 06 — Inventory Tracking | Module 07 — Payment Tracking | Module 08 — Event Equipment Accountability",
    "Module 09 — Report Generation",
    "Module 10 — Audit Trails (Cross-cutting)"
  ],
  "modules": [
    {
      "id": "MOD-01",
      "name": "Module 01 — User Access and Role-Based Access Control",
      "purpose": "Authenticate users, manage identities, assign roles, enforce access restrictions.",
      "allowed_entities": ["Role", "User", "Audit Trail"],
      "records_created_updated": ["User (create/update)", "Audit Trail (create)"],
      "exposed_interfaces": ["AuthenticatedUserContext", "RoleContext", "Permission Check Contract"],
      "applicable_roles": ["administrator", "authorized_staff", "customer"],
      "prohibited_responsibilities": ["Cannot handle customer reservation input or inventory logic."]
    },
    {
      "id": "MOD-02",
      "name": "Module 02 — Catering Packages and Menu",
      "purpose": "Maintain master packages, menu items, and package-menu associations.",
      "allowed_entities": ["Catering Package", "Menu Item", "Package Menu Item"],
      "records_created_updated": ["Catering Package", "Menu Item", "Package Menu Item"],
      "exposed_interfaces": ["PackageSummary", "PackageDetails", "MenuSelection"],
      "applicable_roles": ["customer (read-only)", "authorized_staff (manage)", "administrator (manage)"]
    },
    {
      "id": "MOD-03",
      "name": "Module 03 — Online Reservation",
      "purpose": "Capture customer reservation details, event dates, and initial booking requests.",
      "allowed_entities": ["Reservation", "User", "Package Customization"],
      "records_created_updated": ["Reservation (create requested status)"],
      "exposed_interfaces": ["ReservationRequest", "ReservationSummary"],
      "dependencies": ["Module 01", "Module 02"],
      "applicable_roles": ["customer (submit)", "authorized_staff (view/review)", "administrator (view/review)"]
    },
    {
      "id": "MOD-04",
      "name": "Module 04 — Event Scheduling",
      "purpose": "Manage single-day/multi-day schedules, check date availability, prevent booking overlaps.",
      "allowed_entities": ["Reservation", "Event Schedule", "Catering Order"],
      "records_created_updated": ["Event Schedule (create/update)", "Reservation (update status to confirmed)", "Catering Order (trigger creation)"],
      "exposed_interfaces": ["Date Availability", "Schedule Conflict Check", "Approved Event Schedule"],
      "dependencies": ["Module 03"],
      "applicable_roles": ["authorized_staff", "administrator"]
    },
    {
      "id": "MOD-05",
      "name": "Module 05 — Package Customization",
      "purpose": "Allow guest count selection, dish choices, food/service/supply requirement calculations, price snapshots.",
      "allowed_entities": ["Package Customization", "Reservation Menu Item", "Reservation Service Requirement", "Reservation Inventory Requirement"],
      "records_created_updated": ["Package Customization", "Reservation Menu Item", "Reservation Service Requirement", "Reservation Inventory Requirement"],
      "exposed_interfaces": ["Customization Contract", "Price Snapshot Contract"],
      "dependencies": ["Module 02", "Module 03"]
    },
    {
      "id": "MOD-06",
      "name": "Module 06 — Inventory Tracking",
      "purpose": "Track ingredients/supplies, additions, stock reservations/deductions for confirmed orders, flag low stock.",
      "allowed_entities": ["Inventory Item", "Inventory Movement", "Reservation Inventory Requirement", "Catering Order"],
      "records_created_updated": ["Inventory Item (update quantities)", "Inventory Movement (append-only creation)"],
      "exposed_interfaces": ["Stock Availability", "Inventory Movement Contract", "Insufficient Stock Warning"],
      "dependencies": ["Module 07 (Confirmed Catering Order)"],
      "applicable_roles": ["authorized_staff", "administrator"]
    },
    {
      "id": "MOD-07",
      "name": "Module 07 — Payment Tracking",
      "purpose": "Record deposits and installment payments for confirmed orders, compute paid totals, balances, and payment status.",
      "allowed_entities": ["Catering Order", "Payment Transaction"],
      "records_created_updated": ["Payment Transaction (append-only creation)", "Catering Order (derived payment status)"],
      "exposed_interfaces": ["Payment Summary", "Payment Transaction Contract"],
      "dependencies": ["Module 04/07 (Confirmed Catering Order)"],
      "applicable_roles": ["authorized_staff", "administrator"]
    },
    {
      "id": "MOD-08",
      "name": "Module 08 — Event Equipment Accountability",
      "purpose": "Track reusable equipment release and record manual physical return verification (returned, missing, damaged).",
      "allowed_entities": ["Equipment Item", "Event Equipment Accountability", "Event Equipment Accountability Item", "Catering Order"],
      "records_created_updated": ["Event Equipment Accountability", "Event Equipment Accountability Item"],
      "exposed_interfaces": ["Equipment Release Contract", "Equipment Verification Contract"],
      "dependencies": ["Module 07 (Confirmed Catering Order)"],
      "applicable_roles": ["authorized_staff", "administrator"]
    },
    {
      "id": "MOD-09",
      "name": "Module 09 — Report Generation",
      "purpose": "Generate operational/managerial reports (reservations, sales, payments, inventory, equipment) with CSV/Excel export and print support.",
      "allowed_entities": ["Reads all system entities (Read-Only)"],
      "records_created_updated": [],
      "prohibited_responsibilities": ["Cannot modify source operational records."]
    },
    {
      "id": "MOD-10",
      "name": "Module 10 — Audit Trails",
      "purpose": "Record immutable log of system actions, security changes, and data modifications across all modules.",
      "allowed_entities": ["Audit Trail"],
      "records_created_updated": ["Audit Trail (append-only creation)"],
      "applicable_roles": ["administrator (read/review)", "system (write)"]
    }
  ]
}
