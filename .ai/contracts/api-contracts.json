{
  "title": "Logical API Operation Contracts",
  "file_id": "api-contracts.json",
  "operations": [
    {
      "name": "ResolveAuthenticatedUser",
      "owner": "Module 01",
      "permitted_roles": ["administrator", "authorized_staff", "customer"],
      "inputs": ["authentication_id (string)"],
      "validation": "authentication_id must not be empty.",
      "records_read": ["User", "Role"],
      "success_result": "AuthenticatedUserContext",
      "error_conditions": ["USER_NOT_FOUND", "INVALID_AUTH"]
    },
    {
      "name": "CheckModulePermission",
      "owner": "Module 01",
      "permitted_roles": ["administrator", "authorized_staff", "customer"],
      "inputs": ["user_id (string)", "target_module (string)", "required_action (string)"],
      "success_result": "{ permitted: true/false }"
    },
    {
      "name": "ListPackages",
      "owner": "Module 02",
      "permitted_roles": ["customer", "authorized_staff", "administrator"],
      "inputs": [],
      "records_read": ["Catering Package"],
      "success_result": "Array of PackageSummary"
    },
    {
      "name": "ReadPackageDetails",
      "owner": "Module 02",
      "permitted_roles": ["customer", "authorized_staff", "administrator"],
      "inputs": ["package_id (string)"],
      "records_read": ["Catering Package", "Package Menu Item", "Menu Item"],
      "success_result": "PackageDetails"
    },
    {
      "name": "SubmitReservationRequest",
      "owner": "Module 03",
      "permitted_roles": ["customer"],
      "inputs": ["ReservationRequestPayload"],
      "validation": "Customer must own session; preferred_end_datetime > preferred_start_datetime; guest_count > 0; package must exist.",
      "records_created": ["Reservation (requested)", "Package Customization", "requirements"],
      "success_result": "ReservationSummary",
      "audit": "Action RESERVATION_SUBMITTED"
    },
    {
      "name": "ReadCustomerReservation",
      "owner": "Module 03",
      "permitted_roles": ["customer (own records)", "authorized_staff (all)", "administrator (all)"],
      "inputs": ["reservation_id (string)"],
      "validation": "If customer, reservation.customer_user_id == session.user_id",
      "success_result": "Detailed reservation object"
    },
    {
      "name": "CheckDateAvailability",
      "owner": "Module 04",
      "permitted_roles": ["customer", "authorized_staff", "administrator"],
      "inputs": ["start_datetime (ISO string)", "end_datetime (ISO string)"],
      "validation": "end_datetime > start_datetime",
      "records_read": ["Event Schedule"],
      "success_result": "{ available: true/false, overlapping_schedules: [] }"
    },
    {
      "name": "ConfirmReservationAndCreateSchedule",
      "owner": "Module 04",
      "permitted_roles": ["authorized_staff", "administrator"],
      "inputs": ["reservation_id (string)", "start_datetime (ISO string)", "end_datetime (ISO string)"],
      "validation": "No overlapping confirmed schedule.",
      "records_created": ["Event Schedule", "Catering Order (confirmed)"],
      "records_updated": ["Reservation (confirmed)"],
      "success_result": "{ schedule_id, order_id }",
      "audit": "Action RESERVATION_CONFIRMED"
    },
    {
      "name": "CalculateCustomizationResults",
      "owner": "Module 05",
      "permitted_roles": ["customer", "authorized_staff", "administrator"],
      "inputs": ["package_id (string)", "guest_count (integer)", "selected_menu_item_ids (array)"],
      "validation": "Selected menu items must belong to package_id.",
      "success_result": "Calculated price snapshot, service & inventory requirements."
    },
    {
      "name": "ReadInventoryAvailability",
      "owner": "Module 06",
      "permitted_roles": ["authorized_staff", "administrator"],
      "inputs": ["inventory_item_id (optional string)"],
      "records_read": ["Inventory Item"],
      "success_result": "Array of InventoryAvailability"
    },
    {
      "name": "AddInventoryStock",
      "owner": "Module 06",
      "permitted_roles": ["authorized_staff", "administrator"],
      "inputs": ["inventory_item_id (string)", "added_quantity (number > 0)"],
      "records_updated": ["Inventory Item"],
      "history_created": "Inventory Movement (addition)",
      "audit": "Action INVENTORY_ADDED"
    },
    {
      "name": "ProcessOrderInventoryDeduction",
      "owner": "Module 06",
      "permitted_roles": ["authorized_staff", "administrator"],
      "inputs": ["order_id (string)"],
      "validation": "Order status must be confirmed.",
      "records_updated": ["Inventory Item"],
      "history_created": "Inventory Movement (deduction)",
      "audit": "Action INVENTORY_DEDUCTED"
    },
    {
      "name": "RecordPaymentTransaction",
      "owner": "Module 07",
      "permitted_roles": ["authorized_staff", "administrator"],
      "inputs": ["order_id (string)", "payment_type (deposit/payment)", "amount (monetary > 0)"],
      "validation": "amount + total_paid <= total_amount.",
      "records_created": ["Payment Transaction (append-only)"],
      "records_updated": ["Catering Order (re-derived status)"],
      "success_result": "PaymentSummary",
      "audit": "Action PAYMENT_RECORDED"
    },
    {
      "name": "RecordEquipmentRelease",
      "owner": "Module 08",
      "permitted_roles": ["authorized_staff", "administrator"],
      "inputs": ["EquipmentReleasePayload"],
      "validation": "Order status must be confirmed. Released quantity <= available equipment.",
      "records_created": ["Event Equipment Accountability", "Event Equipment Accountability Item"],
      "audit": "Action EQUIPMENT_RELEASED"
    },
    {
      "name": "RecordEquipmentVerification",
      "owner": "Module 08",
      "permitted_roles": ["authorized_staff", "administrator"],
      "inputs": ["EquipmentVerificationPayload"],
      "validation": "released_quantity == returned_quantity + missing_quantity + damaged_quantity",
      "records_updated": ["Event Equipment Accountability Item"],
      "audit": "Action EQUIPMENT_VERIFIED"
    },
    {
      "name": "GenerateReport",
      "owner": "Module 09",
      "permitted_roles": ["authorized_staff", "administrator"],
      "inputs": ["ReportRequest"],
      "records_read": ["Source operational and history records (Read-Only)"],
      "success_result": "Formatted report payload, CSV string, or print layout"
    },
    {
      "name": "RecordAuditEvent",
      "owner": "Module 10",
      "permitted_roles": ["system internal"],
      "inputs": ["AuditEventPayload"],
      "records_created": ["Audit Trail (append-only)"]
    },
    {
      "name": "ReadAuditTrail",
      "owner": "Module 10",
      "permitted_roles": ["administrator"],
      "inputs": ["Filter parameters"],
      "success_result": "Array of Audit Trail records"
    }
  ]
}
